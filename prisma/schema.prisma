generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  active
  paused
  ended
}

enum InvoiceStatus {
  issued
  paid
}

enum BillStatus {
  unpaid
  paid
}

model Student {
  id         String        @id @default(uuid()) @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  name       String
  monthlyFee Decimal       @map("monthly_fee") @db.Decimal(10, 2)
  status     StudentStatus @default(active)
  startDate  DateTime      @map("start_date") @db.Date
  email      String?
  phone      String?
  guardian   String?

  invoices Invoice[] @relation("StudentInvoices")

  @@index([status])
  @@map("students")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  studentId    String        @map("student_id") @db.Uuid
  billingMonth DateTime      @map("billing_month") @db.Date
  amount       Decimal       @db.Decimal(10, 2)
  status       InvoiceStatus @default(issued)
  dueDate      DateTime      @map("due_date") @db.Date
  paidAt       DateTime?     @map("paid_at")
  paidAmount   Decimal?      @map("paid_amount") @db.Decimal(10, 2)
  issuedDate   DateTime?     @map("issued_date")

  student Student @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status, dueDate])
  @@index([billingMonth])
  @@map("invoices")
}

model Bill {
  id        String     @id @default(uuid()) @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  amount    Decimal    @db.Decimal(10, 2)
  dueDate   DateTime   @map("due_date") @db.Date
  status    BillStatus @default(unpaid)
  details   String?    @db.Text
  paidAt    DateTime?  @map("paid_at")
  title     String?

  @@index([status, dueDate])
  @@map("bills")
}